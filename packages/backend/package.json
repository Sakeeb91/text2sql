{
  "name": "@text2sql/backend",
  "version": "1.0.0",
  "description": "NestJS backend for Text-to-SQL application",
  "main": "./dist/main.js",
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "nest start",
    "start:prod": "node dist/main",
    "clean": "rm -rf dist",
    "type-check": "tsc --noEmit",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\"",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "keywords": [
    "text2sql",
    "backend",
    "nestjs",
    "api"
  ],
  "author": "Sakeeb Rahman <rahman.sakeeb@gmail.com>",
  "license": "MIT",
  "dependencies": {
    "@nestjs/common": "^10.3.0",
    "@nestjs/config": "^3.1.1",
    "@nestjs/core": "^10.3.0",
    "@nestjs/platform-express": "^10.3.0",
    "@nestjs/swagger": "^7.1.17",
    "@text2sql/shared": "workspace:*",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.0",
    "joi": "^17.11.0",
    "openai": "4",
    "reflect-metadata": "^0.1.14",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.2.1",
    "@nestjs/schematics": "^10.0.3",
    "@types/express": "^4.17.21",
    "@types/joi": "^17.2.3",
    "@types/node": "^20.11.5",
    "@vitest/coverage-v8": "^1.6.0",
    "typescript": "^5.3.3",
    "vitest": "^1.6.0"
  }
}
