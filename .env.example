# ==============================================================================
# Text-to-SQL Environment Template
# ------------------------------------------------------------------------------
# Copy this file to `.env` and customize the values for your environment.
# Used by both the Python (FastAPI) stack and the TypeScript (NestJS) stack.
# ==============================================================================

# --- AI Provider --------------------------------------------------------------
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
OPENAI_TEMPERATURE=0.1

# --- Database -----------------------------------------------------------------
# Default for Python stack (SQLite). The TypeScript stack uses PostgreSQL.
DATABASE_URL=sqlite:///./data/database.db
# DATABASE_URL=postgresql://postgres:postgres@postgres:5432/text2sql

# --- Backend Networking -------------------------------------------------------
# FastAPI listens on 8000, NestJS listens on 3000 by default.
PORT=3000
NODE_ENV=development

# --- CORS Configuration -------------------------------------------------------
CORS_ALLOW_ORIGINS=http://localhost:8501,https://*.streamlit.app

# --- Frontend -----------------------------------------------------------------
# STREAMLIT_API_URL=http://localhost:8000
# NEXT_PUBLIC_API_URL=http://localhost:3000

# Keep this file updated when new environment variables are introduced.
